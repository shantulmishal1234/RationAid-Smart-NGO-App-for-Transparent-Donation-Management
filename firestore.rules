rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ──────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (
          'admin' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles ||
          'ngo_admin' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles
        );
    }

    function isOwner(resourceData) {
      return isAuthenticated() && resourceData.donorId == request.auth.uid;
    }

    // ─── Donations ─────────────────────────────────────────────────────────
    match /donations/{donationId} {
      // Donors can read their own donations; admins can read all
      allow read: if isAuthenticated() &&
        (isAdmin() || resource.data.donorId == request.auth.uid);

      // Donors can create donations (status must be draft or under_verification)
      allow create: if isAuthenticated() &&
        request.resource.data.donorId == request.auth.uid &&
        request.resource.data.status in ['draft', 'under_verification'];

      // Donors can update only their drafts (status must remain draft or go to under_verification)
      // Admins can update any donation
      allow update: if isAuthenticated() &&
        (isAdmin() ||
         (isOwner(resource.data) &&
          resource.data.status == 'draft' &&
          request.resource.data.status in ['draft', 'under_verification']));

      // Only drafts can be deleted, only by owner
      allow delete: if isAuthenticated() &&
        isOwner(resource.data) &&
        resource.data.status == 'draft';
    }

    // ─── Families ──────────────────────────────────────────────────────────
    match /families/{familyId} {
      // Anyone authenticated can read accepted families (for donor explore)
      allow read: if isAuthenticated();

      // Only admins can write (create/update/delete)
      allow write: if isAdmin();
    }

    // ─── Master Ledger ─────────────────────────────────────────────────────
    match /master_ledger/{docId} {
      // Only admins can read and write
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ─── Master Ledger Audit ───────────────────────────────────────────────
    match /master_ledger_audit/{docId} {
      // Admins can read; system writes (via admin context)
      allow read: if isAdmin();
      allow create: if isAuthenticated(); // Created during transactions
      allow update, delete: if false; // Immutable audit trail
    }

    // ─── Pool Transfers ────────────────────────────────────────────────────
    match /pool_transfers/{docId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false; // Immutable records
    }

    // ─── Users ─────────────────────────────────────────────────────────────
    match /users/{memberId} {
      // Users can read their own profile; admins can read all
      allow read: if isAuthenticated() &&
        (isAdmin() || memberId == request.auth.uid);

      // Only admins can write user records directly
      allow write: if isAdmin();

      // Users can update their own profile (limited fields)
      allow update: if isAuthenticated() &&
        memberId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'photoUrl', 'fcmToken', 'profileCompleted']);
    }

    // ─── Notifications ─────────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // ─── Procurement Requests ──────────────────────────────────────────────
    match /procurement_requests/{requestId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ─── Audit Logs ────────────────────────────────────────────────────────
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Immutable
    }

    // ─── Default Deny ──────────────────────────────────────────────────────
    // Any collection not explicitly matched above is denied
  }
}
